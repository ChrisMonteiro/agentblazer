<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1280 720" width="1280" height="720">
  <defs>
    <linearGradient id="labBg3" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#F1F5F9"/>
      <stop offset="45%" stop-color="#E2E8F0"/>
      <stop offset="100%" stop-color="#94A3B8"/>
    </linearGradient>
    <linearGradient id="mapCardBg3" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#0F172A" stop-opacity="0.94"/>
      <stop offset="100%" stop-color="#020617" stop-opacity="0.98"/>
    </linearGradient>
  </defs>

  <rect width="1280" height="720" fill="url(#labBg3)"/>

  <!-- Ceiling Fans & Grid -->
  <g stroke="#CBD5E1" stroke-width="1.5">
    <line x1="0" y1="60" x2="1280" y2="60"/>
    <line x1="0" y1="120" x2="1280" y2="120"/>
    <line x1="0" y1="180" x2="1280" y2="180"/>
  </g>
  <g transform="translate(620, 60)" opacity="0.8">
    <circle cx="0" cy="0" r="10" fill="#475569"/>
    <ellipse cx="-40" cy="-5" rx="50" ry="8" fill="#64748B"/>
    <ellipse cx="35" cy="-10" rx="50" ry="8" fill="#64748B" transform="rotate(-20)"/>
    <ellipse cx="5" cy="40" rx="50" ry="8" fill="#64748B" transform="rotate(80)"/>
  </g>

  <!-- Front Wall Projection Screen -->
  <g transform="translate(940, 140)">
    <rect x="0" y="0" width="310" height="170" rx="4" fill="#FFFFFF" stroke="#0284C7" stroke-width="2"/>
    <text x="155" y="65" font-family="'Plus Jakarta Sans', sans-serif" font-size="18" font-weight="900" fill="#0284C7" text-anchor="middle">I'm excited to see what</text>
    <text x="155" y="98" font-family="'Plus Jakarta Sans', sans-serif" font-size="18" font-weight="900" fill="#0284C7" text-anchor="middle">you build.</text>
    <text x="155" y="130" font-family="'JetBrains Mono', monospace" font-size="8.5" fill="#0369A1" text-anchor="middle">Questions? DM me on twitter @anxkhn</text>
  </g>

  <!-- Speaker Anas Khan -->
  <g transform="translate(710, 220)">
    <circle cx="8" cy="8" r="8" fill="#FBD38D"/>
    <rect x="0" y="16" width="16" height="34" rx="3" fill="#059669"/>
    <rect x="2" y="50" width="5" height="28" fill="#1E293B"/>
    <rect x="9" y="50" width="5" height="28" fill="#1E293B"/>
  </g>

  <!-- Full Lab Workstations & Student Coders -->
  <!-- Back Tier -->
  <g transform="translate(80, 270)">
    <rect x="0" y="0" width="1120" height="20" rx="2" fill="#E2E8F0" stroke="#94A3B8"/>
    <circle cx="80" cy="-6" r="10" fill="#1E293B"/>
    <circle cx="210" cy="-6" r="10" fill="#334155"/>
    <circle cx="360" cy="-6" r="10" fill="#1E293B"/>
    <circle cx="510" cy="-6" r="10" fill="#475569"/>
    <circle cx="660" cy="-6" r="10" fill="#1E293B"/>
    <circle cx="810" cy="-6" r="10" fill="#334155"/>
  </g>

  <!-- Mid Tier with Laptops & Desktop Monitors -->
  <g transform="translate(40, 360)">
    <rect x="0" y="0" width="1200" height="28" rx="3" fill="#CBD5E1" stroke="#64748B"/>
    <!-- Computers & Screens -->
    <rect x="120" y="-32" width="50" height="32" rx="2" fill="#0F172A"/>
    <rect x="122" y="-30" width="46" height="25" fill="#38BDF8" fill-opacity="0.9"/>
    
    <rect x="300" y="-32" width="50" height="32" rx="2" fill="#0F172A"/>
    <rect x="302" y="-30" width="46" height="25" fill="#10B981" fill-opacity="0.9"/>

    <rect x="490" y="-32" width="50" height="32" rx="2" fill="#0F172A"/>
    <rect x="492" y="-30" width="46" height="25" fill="#A855F7" fill-opacity="0.9"/>

    <rect x="680" y="-32" width="50" height="32" rx="2" fill="#0F172A"/>
    <rect x="682" y="-30" width="46" height="25" fill="#F59E0B" fill-opacity="0.9"/>

    <rect x="870" y="-32" width="50" height="32" rx="2" fill="#0F172A"/>
    <rect x="872" y="-30" width="46" height="25" fill="#38BDF8" fill-opacity="0.9"/>
    
    <!-- Student Bodies -->
    <circle cx="80" cy="8" r="16" fill="#1E293B"/>
    <circle cx="260" cy="8" r="16" fill="#334155"/>
    <circle cx="450" cy="8" r="16" fill="#1E293B"/>
    <circle cx="640" cy="8" r="16" fill="#475569"/>
    <circle cx="830" cy="8" r="16" fill="#1E293B"/>
  </g>

  <!-- Foreground Row -->
  <g transform="translate(0, 480)">
    <rect x="0" y="0" width="1280" height="140" fill="#DC2626" stroke="#991B1B" stroke-width="2"/>
    <line x1="0" y1="12" x2="1280" y2="12" stroke="#EF4444" stroke-width="2"/>

    <!-- Left Foreground Laptop -->
    <g transform="translate(80, -50)">
      <polygon points="10,120 150,120 170,170 -10,170" fill="#0F172A" stroke="#334155"/>
      <rect x="0" y="0" width="160" height="115" rx="3" fill="#020617" stroke="#475569"/>
      <rect x="5" y="5" width="150" height="105" fill="#030712"/>
      <line x1="15" y1="18" x2="80" y2="18" stroke="#38BDF8" stroke-width="2"/>
      <line x1="15" y1="28" x2="120" y2="28" stroke="#10B981" stroke-width="2"/>
      <line x1="25" y1="38" x2="140" y2="38" stroke="#F59E0B" stroke-width="2"/>
      <line x1="25" y1="48" x2="100" y2="48" stroke="#A855F7" stroke-width="2"/>
      <line x1="15" y1="58" x2="60" y2="58" stroke="#38BDF8" stroke-width="2"/>
      <line x1="25" y1="68" x2="130" y2="68" stroke="#94A3B8" stroke-width="2"/>
    </g>

    <!-- Foreground Student 1 -->
    <g transform="translate(270, 20)">
      <circle cx="35" cy="0" r="26" fill="#0F172A"/>
      <path d="M-10 30 L80 30 L90 180 L-20 180 Z" fill="#F8FAFC" stroke="#CBD5E1"/>
    </g>

    <!-- Center Laptop -->
    <g transform="translate(420, -50)">
      <polygon points="10,120 150,120 170,170 -10,170" fill="#0F172A" stroke="#334155"/>
      <rect x="0" y="0" width="160" height="115" rx="3" fill="#020617" stroke="#475569"/>
      <rect x="5" y="5" width="150" height="105" fill="#030712"/>
      <line x1="15" y1="18" x2="90" y2="18" stroke="#A855F7" stroke-width="2"/>
      <line x1="25" y1="28" x2="130" y2="28" stroke="#38BDF8" stroke-width="2"/>
      <line x1="25" y1="38" x2="110" y2="38" stroke="#10B981" stroke-width="2"/>
      <line x1="15" y1="48" x2="60" y2="48" stroke="#F59E0B" stroke-width="2"/>
    </g>

    <!-- Right Student -->
    <g transform="translate(620, 20)">
      <circle cx="35" cy="0" r="26" fill="#1E293B"/>
      <path d="M-10 30 L80 30 L90 180 L-20 180 Z" fill="#1E293B"/>
    </g>
  </g>

  <!-- GPS Map Camera Card -->
  <g transform="translate(340, 540)">
    <rect x="0" y="0" width="620" height="165" rx="14" fill="url(#mapCardBg3)" stroke="#334155" stroke-width="1.5"/>
    
    <g transform="translate(460, 12)">
      <rect x="0" y="0" width="145" height="26" rx="6" fill="#1E293B" stroke="#475569"/>
      <circle cx="18" cy="13" r="6" fill="#38BDF8"/>
      <circle cx="18" cy="13" r="3" fill="#F59E0B"/>
      <text x="32" y="17" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="700" fill="#FFFFFF">GPS Map Camera</text>
    </g>

    <g transform="translate(14, 14)">
      <rect x="0" y="0" width="135" height="135" rx="10" fill="#1E293B" stroke="#475569"/>
      <rect x="8" y="8" width="119" height="119" fill="#334155" rx="6"/>
      <rect x="25" y="25" width="40" height="30" fill="#854D0E" rx="2"/>
      <rect x="70" y="30" width="35" height="40" fill="#78350F" rx="2"/>
      <rect x="30" y="70" width="70" height="35" fill="#9A3412" rx="2"/>
      <g transform="translate(60, 50)">
        <path d="M0 12 L-5 3 C-7 -1 -7 -5 0 -7 C7 -5 7 -1 5 3 Z" fill="#EF4444"/>
        <circle cx="0" cy="-2" r="2.5" fill="#FFFFFF"/>
      </g>
    </g>

    <g transform="translate(165, 20)">
      <text x="0" y="16" font-family="'Plus Jakarta Sans', sans-serif" font-size="18" font-weight="800" fill="#FFFFFF">Mangaluru, Karnataka, India 🇮🇳</text>
      <text x="0" y="42" font-family="'Plus Jakarta Sans', sans-serif" font-size="11" font-weight="600" fill="#E2E8F0">Panvel Kochi Kanyakumari Highway, Thiruvail, Mangaluru,</text>
      <text x="0" y="58" font-family="'Plus Jakarta Sans', sans-serif" font-size="11" font-weight="600" fill="#CBD5E1">Karnataka 575028, India</text>
      <text x="0" y="85" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="600" fill="#38BDF8">Lat 12.910572, Long 74.899409</text>
      <text x="0" y="105" font-family="'Plus Jakarta Sans', sans-serif" font-size="12" font-weight="700" fill="#FFFFFF">Saturday, 14/02/2026 04:48 PM GMT+05:30</text>
      <text x="0" y="125" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="500" fill="#94A3B8">Note : Captured by GPS Map Camera</text>
    </g>
  </g>
</svg>
