<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 700" width="1000" height="700">
  <defs>
    <linearGradient id="valedictoryBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#050711"/>
      <stop offset="50%" stop-color="#120A24"/>
      <stop offset="100%" stop-color="#04030A"/>
    </linearGradient>

    <linearGradient id="goldGradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F59E0B"/>
      <stop offset="50%" stop-color="#FDE047"/>
      <stop offset="100%" stop-color="#D97706"/>
    </linearGradient>

    <radialGradient id="stageLighting" cx="50%" cy="30%" r="60%">
      <stop offset="0%" stop-color="#00F0FF" stop-opacity="0.25"/>
      <stop offset="40%" stop-color="#A855F7" stop-opacity="0.2"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0"/>
    </radialGradient>
  </defs>

  <!-- Background Base -->
  <rect width="1000" height="700" fill="url(#valedictoryBg)"/>
  <circle cx="500" cy="300" r="480" fill="url(#stageLighting)"/>

  <!-- Stage Backdrop Banner -->
  <rect x="70" y="40" width="860" height="230" rx="16" fill="#0A0E22" stroke="#00F0FF" stroke-width="2" stroke-opacity="0.5"/>
  <rect x="85" y="55" width="830" height="200" rx="10" fill="#050816"/>

  <g transform="translate(500, 90)">
    <text text-anchor="middle" font-family="'Plus Jakarta Sans', sans-serif" font-size="13" font-weight="800" fill="#38BDF8" letter-spacing="4">
      ST JOSEPH ENGINEERING COLLEGE • DEPARTMENT OF CSE
    </text>
    <text y="24" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="11" fill="#94A3B8" letter-spacing="3">
      AGENTBLAZER CLUB &amp; CIPHER JOINT ANNUAL TECHNICAL EVENT
    </text>
    <text y="68" text-anchor="middle" font-family="'Plus Jakarta Sans', sans-serif" font-size="34" font-weight="900" fill="#FFFFFF" letter-spacing="1">
      "PROMPT OPS-2K26" VALEDICTORY &amp; AWARDS
    </text>
    <text y="100" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="13" font-weight="700" fill="#FDE047" letter-spacing="3">
      HONORING WINNERS &amp; PARTICIPANTS // MARCH 25, 2026
    </text>
  </g>

  <!-- Stage Platform Podium -->
  <polygon points="120,440 880,440 940,550 60,550" fill="#080D20" stroke="#00F0FF" stroke-width="2" stroke-opacity="0.5"/>
  <line x1="80" y1="460" x2="920" y2="460" stroke="#A855F7" stroke-opacity="0.4" stroke-width="1.5"/>

  <!-- Central Trophy Display -->
  <g transform="translate(500, 370)">
    <!-- Main Cup -->
    <path d="M -25 -50 L 25 -50 L 20 0 C 20 20, -20 20, -20 0 Z" fill="url(#goldGradient)" stroke="#FDE047" stroke-width="1.5"/>
    <!-- Handles -->
    <path d="M -22 -40 C -40 -40, -40 -15, -18 -10" fill="none" stroke="url(#goldGradient)" stroke-width="4"/>
    <path d="M 22 -40 C 40 -40, 40 -15, 18 -10" fill="none" stroke="url(#goldGradient)" stroke-width="4"/>
    <!-- Stem & Base -->
    <rect x="-6" y="16" width="12" height="20" fill="url(#goldGradient)"/>
    <polygon points="-22,36 22,36 28,52 -28,52" fill="#1E293B" stroke="#FDE047" stroke-width="1"/>
    <!-- Glow -->
    <circle cx="0" cy="-20" r="45" fill="#FDE047" fill-opacity="0.15"/>
  </g>

  <!-- Left Side: Track 1 Winners Certificate Presentation -->
  <g transform="translate(230, 360)">
    <rect x="-140" y="-70" width="280" height="140" rx="12" fill="#0A1128" stroke="#00F0FF" stroke-width="1.5"/>
    <rect x="-140" y="-70" width="280" height="30" rx="12" fill="#00F0FF" fill-opacity="0.15"/>
    <text text-anchor="middle" y="-50" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="800" fill="#00F0FF">
      TRACK 1 (1ST YEAR) HONORS
    </text>
    <text x="-120" y="-20" font-family="'Plus Jakarta Sans', sans-serif" font-size="13" font-weight="700" fill="#FDE047">
      1st: Chinmayee
    </text>
    <text x="-120" y="5" font-family="'Plus Jakarta Sans', sans-serif" font-size="13" font-weight="700" fill="#E2E8F0">
      2nd: Chris Royston Monteiro
    </text>
    <text x="-120" y="30" font-family="'Plus Jakarta Sans', sans-serif" font-size="13" font-weight="700" fill="#CBD5E1">
      3rd: Deeksha Ravi Moger
    </text>
    <text x="-120" y="52" font-family="'JetBrains Mono', monospace" font-size="10" fill="#38BDF8">
      Category: Invitation &amp; Logo Recreation
    </text>
  </g>

  <!-- Right Side: Track 2 Winners Certificate Presentation -->
  <g transform="translate(770, 360)">
    <rect x="-140" y="-70" width="280" height="140" rx="12" fill="#0A1128" stroke="#A855F7" stroke-width="1.5"/>
    <rect x="-140" y="-70" width="280" height="30" rx="12" fill="#A855F7" fill-opacity="0.15"/>
    <text text-anchor="middle" y="-50" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="800" fill="#C084FC">
      TRACK 2 (2ND YEAR) HONORS
    </text>
    <text x="-120" y="-20" font-family="'Plus Jakarta Sans', sans-serif" font-size="13" font-weight="700" fill="#FDE047">
      1st: Harimurali KS
    </text>
    <text x="-120" y="5" font-family="'Plus Jakarta Sans', sans-serif" font-size="13" font-weight="700" fill="#E2E8F0">
      2nd: Venus Suhani D’Lima
    </text>
    <text x="-120" y="30" font-family="'Plus Jakarta Sans', sans-serif" font-size="13" font-weight="700" fill="#CBD5E1">
      3rd: Venisha Snehal D’Souza
    </text>
    <text x="-120" y="52" font-family="'JetBrains Mono', monospace" font-size="10" fill="#FDE047">
      Category: Python &amp; Gemini Prompt Security
    </text>
  </g>

  <!-- Faculty Coordinators & Dignitaries Silhouettes on Stage -->
  <g transform="translate(360, 430)" fill="#1E293B">
    <!-- Dignitary 1 -->
    <ellipse cx="0" cy="-35" rx="18" ry="20"/>
    <path d="M -30 40 C -30 0, 30 0, 30 40 Z"/>
  </g>
  <g transform="translate(640, 430)" fill="#1E293B">
    <!-- Dignitary 2 -->
    <ellipse cx="0" cy="-35" rx="18" ry="20"/>
    <path d="M -30 40 C -30 0, 30 0, 30 40 Z"/>
  </g>

  <!-- Bottom Stage Front Panel -->
  <g transform="translate(500, 610)">
    <rect x="-420" y="-35" width="840" height="70" rx="14" fill="#070A18" stroke="#1E293B" stroke-width="1.5"/>
    <text text-anchor="middle" y="-8" font-family="'Plus Jakarta Sans', sans-serif" font-size="15" font-weight="800" fill="#FFFFFF">
      COORDINATED UNDER GUIDANCE OF MS. NISHA J ROCHE, MS. JAISHMA K &amp; HOD DR. MELWYN D’SOUZA
    </text>
    <text text-anchor="middle" y="18" font-family="'JetBrains Mono', monospace" font-size="11" font-weight="600" fill="#38BDF8">
      AGENTBLAZER CLUB LEADERSHIP &amp; CIPHER TECHNICAL COMMITTEE • SJEC
    </text>
  </g>
</svg>
