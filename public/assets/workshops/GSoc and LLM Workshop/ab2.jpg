<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 720 1280" width="720" height="1280">
  <defs>
    <!-- Classroom Lighting Gradients -->
    <linearGradient id="wallGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#E2E8F0"/>
      <stop offset="60%" stop-color="#F1F5F9"/>
      <stop offset="100%" stop-color="#E2E8F0"/>
    </linearGradient>
    <linearGradient id="floorGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#CBD5E1"/>
      <stop offset="100%" stop-color="#94A3B8"/>
    </linearGradient>
    <linearGradient id="deskRed" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#B91C1C"/>
      <stop offset="100%" stop-color="#DC2626"/>
    </linearGradient>
    <linearGradient id="projectorGlow" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="100%" stop-color="#E0F2FE"/>
    </linearGradient>
    <!-- Map Camera Overlay Gradient -->
    <linearGradient id="mapCardBg" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="#0F172A" stop-opacity="0.95"/>
      <stop offset="100%" stop-color="#020617" stop-opacity="0.98"/>
    </linearGradient>
  </defs>

  <!-- Ceiling -->
  <rect x="0" y="0" width="720" height="420" fill="#F8FAFC"/>
  <!-- Ceiling Grid Lines -->
  <line x1="0" y1="80" x2="720" y2="80" stroke="#CBD5E1" stroke-width="1.5"/>
  <line x1="0" y1="160" x2="720" y2="160" stroke="#CBD5E1" stroke-width="1.5"/>
  <line x1="0" y1="240" x2="720" y2="240" stroke="#CBD5E1" stroke-width="1.5"/>
  <line x1="0" y1="320" x2="720" y2="320" stroke="#CBD5E1" stroke-width="1.5"/>
  <line x1="0" y1="400" x2="720" y2="400" stroke="#CBD5E1" stroke-width="1.5"/>

  <line x1="120" y1="0" x2="120" y2="420" stroke="#CBD5E1" stroke-width="1.5"/>
  <line x1="260" y1="0" x2="260" y2="420" stroke="#CBD5E1" stroke-width="1.5"/>
  <line x1="400" y1="0" x2="400" y2="420" stroke="#CBD5E1" stroke-width="1.5"/>
  <line x1="540" y1="0" x2="540" y2="420" stroke="#CBD5E1" stroke-width="1.5"/>
  <line x1="680" y1="0" x2="680" y2="420" stroke="#CBD5E1" stroke-width="1.5"/>

  <!-- Ceiling Fans -->
  <!-- Fan 1 (Top Left Foreground) -->
  <g transform="translate(100, 110)">
    <circle cx="0" cy="0" r="14" fill="#52525B"/>
    <ellipse cx="-70" cy="-5" rx="60" ry="12" fill="#71717A" transform="rotate(15 -70 -5)"/>
    <ellipse cx="60" cy="-20" rx="60" ry="12" fill="#71717A" transform="rotate(-30 60 -20)"/>
    <ellipse cx="10" cy="65" rx="58" ry="12" fill="#71717A" transform="rotate(85 10 65)"/>
  </g>
  <!-- Fan 2 (Center) -->
  <g transform="translate(410, 310)" opacity="0.85">
    <circle cx="0" cy="0" r="10" fill="#52525B"/>
    <ellipse cx="-45" cy="-5" rx="40" ry="8" fill="#71717A" transform="rotate(10)"/>
    <ellipse cx="40" cy="-15" rx="40" ry="8" fill="#71717A" transform="rotate(-25)"/>
    <ellipse cx="5" cy="45" rx="38" ry="8" fill="#71717A" transform="rotate(80)"/>
  </g>
  <!-- Projector Unit Suspended from Ceiling -->
  <g transform="translate(605, 330)">
    <line x1="0" y1="-80" x2="0" y2="0" stroke="#475569" stroke-width="4"/>
    <rect x="-24" y="0" width="48" height="24" rx="4" fill="#FFFFFF" stroke="#64748B" stroke-width="2"/>
    <circle cx="-10" cy="12" r="5" fill="#38BDF8"/>
  </g>

  <!-- Front Wall & Whiteboard Area -->
  <rect x="0" y="420" width="720" height="340" fill="url(#wallGradient)"/>
  <line x1="0" y1="420" x2="720" y2="420" stroke="#94A3B8" stroke-width="3"/>

  <!-- Big Projection Screen on Right Wall -->
  <g transform="translate(520, 400)">
    <rect x="0" y="0" width="200" height="110" rx="4" fill="url(#projectorGlow)" stroke="#38BDF8" stroke-width="1.5" filter="drop-shadow(0 0 15px rgba(56,189,248,0.3))"/>
    <text x="100" y="40" font-family="'Plus Jakarta Sans', sans-serif" font-size="13" font-weight="900" fill="#0369A1" text-anchor="middle">I'm excited to</text>
    <text x="100" y="62" font-family="'Plus Jakarta Sans', sans-serif" font-size="13" font-weight="900" fill="#0369A1" text-anchor="middle">you build.</text>
    <text x="100" y="80" font-family="'JetBrains Mono', monospace" font-size="6" fill="#0284C7" text-anchor="middle">Questions? Feel free to DM me on twitter @anxkhn</text>
  </g>

  <!-- Stage / Speaker at Podium Area -->
  <g transform="translate(250, 480)">
    <!-- Speaker (Green shirt / tie) -->
    <ellipse cx="10" cy="8" rx="8" ry="10" fill="#FBD38D"/>
    <path d="M2,-2 C2,-8 18,-8 18,-2 Z" fill="#1E293B"/>
    <rect x="0" y="18" width="20" height="35" rx="3" fill="#059669"/>
    <!-- Mic in hand -->
    <line x1="12" y1="26" x2="16" y2="20" stroke="#0F172A" stroke-width="2"/>
    <circle cx="16" cy="19" r="2.5" fill="#0F172A"/>
    <!-- Trousers -->
    <rect x="2" y="53" width="7" height="28" fill="#1E293B"/>
    <rect x="11" y="53" width="7" height="28" fill="#1E293B"/>
  </g>

  <!-- Lab Floor -->
  <rect x="0" y="560" width="720" height="720" fill="url(#floorGradient)"/>

  <!-- Computer Desks Rows & Students with Laptops -->
  <!-- Row 3 (Back) -->
  <g transform="translate(40, 540)">
    <rect x="0" y="0" width="640" height="24" rx="2" fill="#E2E8F0" stroke="#94A3B8" stroke-width="1"/>
    <!-- Back row students -->
    <circle cx="60" cy="-6" r="10" fill="#1E293B"/>
    <circle cx="160" cy="-6" r="10" fill="#334155"/>
    <circle cx="280" cy="-6" r="10" fill="#1E293B"/>
    <circle cx="420" cy="-6" r="10" fill="#334155"/>
  </g>

  <!-- Row 2 (Middle) -->
  <g transform="translate(20, 600)">
    <rect x="0" y="0" width="680" height="40" rx="3" fill="#E2E8F0" stroke="#64748B" stroke-width="1"/>
    <!-- Desks & Laptops -->
    <rect x="70" y="-18" width="36" height="24" rx="2" fill="#334155"/>
    <rect x="72" y="-16" width="32" height="18" fill="#38BDF8" fill-opacity="0.8"/>
    
    <rect x="220" y="-18" width="36" height="24" rx="2" fill="#334155"/>
    <rect x="222" y="-16" width="32" height="18" fill="#A855F7" fill-opacity="0.8"/>

    <rect x="380" y="-18" width="36" height="24" rx="2" fill="#334155"/>
    <rect x="382" y="-16" width="32" height="18" fill="#10B981" fill-opacity="0.8"/>
  </g>

  <!-- Row 1 (Foreground Desk with Red Top) -->
  <g transform="translate(0, 740)">
    <!-- Red Lab Desk Tabletop -->
    <rect x="0" y="0" width="460" height="110" rx="6" fill="url(#deskRed)" stroke="#991B1B" stroke-width="2"/>
    <line x1="0" y1="12" x2="460" y2="12" stroke="#EF4444" stroke-width="2"/>
    <rect x="30" y="110" width="16" height="200" fill="#CBD5E1" stroke="#94A3B8"/>
    <rect x="420" y="110" width="16" height="200" fill="#CBD5E1" stroke="#94A3B8"/>

    <!-- Foreground Student 1 (White polo shirt, back turned, typing) -->
    <g transform="translate(190, 30)">
      <!-- Chair backrest -->
      <rect x="-35" y="70" width="140" height="110" rx="8" fill="#0F172A"/>
      <!-- Head -->
      <circle cx="35" cy="20" r="28" fill="#1E293B"/>
      <!-- Polo Collar & Torso -->
      <path d="M-15 50 L85 50 L95 160 L-25 160 Z" fill="#F1F5F9" stroke="#CBD5E1" stroke-width="1.5"/>
      <polygon points="20,50 35,70 50,50 35,55" fill="#E2E8F0"/>
    </g>

    <!-- Foreground Laptop with Open IDE / Code Screen -->
    <g transform="translate(0, -60)">
      <!-- Base keyboard -->
      <polygon points="10,130 140,130 160,180 -10,180" fill="#1E293B" stroke="#334155" stroke-width="1.5"/>
      <!-- Screen Lid -->
      <rect x="0" y="0" width="150" height="120" rx="4" fill="#090D1A" stroke="#475569" stroke-width="2"/>
      <!-- Code lines glow -->
      <rect x="6" y="6" width="138" height="108" rx="2" fill="#030712"/>
      <line x1="14" y1="18" x2="60" y2="18" stroke="#38BDF8" stroke-width="2.5"/>
      <line x1="14" y1="28" x2="90" y2="28" stroke="#A855F7" stroke-width="2"/>
      <line x1="24" y1="38" x2="110" y2="38" stroke="#10B981" stroke-width="2"/>
      <line x1="24" y1="48" x2="80" y2="48" stroke="#F59E0B" stroke-width="2"/>
      <line x1="14" y1="58" x2="40" y2="58" stroke="#EC4899" stroke-width="2"/>
      <line x1="24" y1="68" x2="120" y2="68" stroke="#94A3B8" stroke-width="2"/>
    </g>

    <!-- Second Laptop on desk -->
    <g transform="translate(340, -40)">
      <rect x="0" y="0" width="110" height="90" rx="4" fill="#090D1A" stroke="#475569" stroke-width="2"/>
      <rect x="4" y="4" width="102" height="82" rx="2" fill="#0F172A"/>
      <line x1="10" y1="16" x2="50" y2="16" stroke="#38BDF8" stroke-width="2"/>
      <line x1="10" y1="26" x2="70" y2="26" stroke="#10B981" stroke-width="1.5"/>
      <line x1="10" y1="36" x2="40" y2="36" stroke="#F59E0B" stroke-width="1.5"/>
    </g>
  </g>

  <!-- GPS Map Camera Verified Overlay Box (Exact reproduction of authentic camera card) -->
  <g transform="translate(12, 1020)">
    <!-- Main Card Body -->
    <rect x="0" y="0" width="696" height="225" rx="16" fill="url(#mapCardBg)" stroke="#334155" stroke-width="1.5"/>
    
    <!-- GPS Map Camera Brand Tag (Top Right) -->
    <g transform="translate(520, 16)">
      <rect x="0" y="0" width="150" height="32" rx="8" fill="#1E293B" stroke="#475569" stroke-width="1"/>
      <circle cx="20" cy="16" r="8" fill="#38BDF8"/>
      <circle cx="20" cy="16" r="4" fill="#F59E0B"/>
      <text x="36" y="21" font-family="'Plus Jakarta Sans', sans-serif" font-size="11" font-weight="700" fill="#FFFFFF">GPS Map Camera</text>
    </g>

    <!-- Left Aerial / Satellite Map Box -->
    <g transform="translate(18, 18)">
      <rect x="0" y="0" width="155" height="155" rx="12" fill="#1E293B" stroke="#475569" stroke-width="1.5" overflow="hidden"/>
      <!-- Stylized Campus Building Layout -->
      <rect x="10" y="10" width="135" height="135" fill="#334155" rx="8"/>
      <!-- Rooftops -->
      <rect x="25" y="25" width="45" height="35" fill="#854D0E" rx="2"/>
      <rect x="80" y="30" width="40" height="50" fill="#78350F" rx="2"/>
      <rect x="30" y="80" width="80" height="40" fill="#9A3412" rx="2"/>
      <!-- Solar panel strips -->
      <line x1="32" y1="88" x2="108" y2="88" stroke="#38BDF8" stroke-width="1.5"/>
      <line x1="32" y1="96" x2="108" y2="96" stroke="#38BDF8" stroke-width="1.5"/>
      <line x1="32" y1="104" x2="108" y2="104" stroke="#38BDF8" stroke-width="1.5"/>

      <!-- Red Map Pin Marker -->
      <g transform="translate(68, 65)">
        <ellipse cx="0" cy="14" rx="6" ry="2.5" fill="#000000" fill-opacity="0.4"/>
        <path d="M0 14 L-6 4 C-9 0 -9 -6 0 -8 C9 -6 9 0 6 4 Z" fill="#EF4444"/>
        <circle cx="0" cy="-2" r="3" fill="#FFFFFF"/>
      </g>

      <!-- Apple Maps / Maps logo watermark -->
      <text x="8" y="180" font-family="'Plus Jakarta Sans', sans-serif" font-size="10" font-weight="700" fill="#94A3B8"> Maps</text>
    </g>

    <!-- Geographic & Event Metadata Text -->
    <g transform="translate(195, 30)">
      <!-- City & Country with Flag -->
      <text x="0" y="20" font-family="'Plus Jakarta Sans', sans-serif" font-size="21" font-weight="800" fill="#FFFFFF">Mangaluru, Karnataka, India 🇮🇳</text>
      
      <!-- Highway & Local Address -->
      <text x="0" y="52" font-family="'Plus Jakarta Sans', sans-serif" font-size="13" font-weight="600" fill="#E2E8F0">Panvel Kochi Kanyakumari Highway, Thiruvail, Mangaluru,</text>
      <text x="0" y="72" font-family="'Plus Jakarta Sans', sans-serif" font-size="13" font-weight="600" fill="#CBD5E1">Karnataka 575028, India</text>

      <!-- GPS Coordinates -->
      <text x="0" y="104" font-family="'JetBrains Mono', monospace" font-size="13" font-weight="600" fill="#38BDF8">Lat 12.910572, Long 74.899409</text>

      <!-- Date & Timestamp -->
      <text x="0" y="128" font-family="'Plus Jakarta Sans', sans-serif" font-size="14" font-weight="700" fill="#FFFFFF">Saturday, 14/02/2026 04:48 PM GMT+05:30</text>

      <!-- Note Watermark -->
      <text x="0" y="152" font-family="'Plus Jakarta Sans', sans-serif" font-size="12" font-weight="500" fill="#94A3B8">Note : Captured by GPS Map Camera</text>
    </g>
  </g>
</svg>
